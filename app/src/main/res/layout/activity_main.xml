<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03070D">

    <!-- PANTALLA LOGIN (OTP) -->
    <LinearLayout
        android:id="@+id/screenLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#03070D">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SENSIS GOOD FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#38BEFF"
            android:letterSpacing="0.15"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GENERADOR DE SENSIBILIDADES"
            android:textSize="10sp"
            android:gravity="center"
            android:textColor="#8AA0BB"
            android:letterSpacing="0.3"
            android:paddingBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 ACCESO EXCLUSIVO"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#38BEFF"
                android:letterSpacing="0.15"
                android:paddingBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicita acceso al administrador.\nSe enviará un código a su correo."
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="#8AA0BB"
                android:paddingBottom="20dp"/>

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📧 SOLICITAR CÓDIGO DE ACCESO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0A84FF"
                android:letterSpacing="0.1"/>

            <ProgressBar
                android:id="@+id/progressOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvOtpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:gravity="center"
                android:textColor="#8AA0BB"
                android:padding="8dp"/>

            <LinearLayout
                android:id="@+id/layoutOtpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="000000"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#E4F2FF"
                    android:textColorHint="#8AA0BB"/>

                <Button
                    android:id="@+id/btnVerifyOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="✅ VERIFICAR CÓDIGO"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#00C853"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- GENERADOR: WebView con el HTML original -->
    <WebView
        android:id="@+id/webViewGenerator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>
